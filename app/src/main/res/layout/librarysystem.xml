<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    tools:context=".BorrowerdetailsActivity"
    tools:visibility="visible">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout"
        android:layout_width="527dp"
        android:layout_height="832dp"
        android:background="#828BB8"
        android:backgroundTint="#244557"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="-2dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/textView"
            android:layout_width="145dp"
            android:layout_height="24dp"
            android:background="#2196F3"
            android:fontFamily="sans-serif-smallcaps"
            android:text="Library System"
            android:textSize="20sp"
            android:textStyle="bold"
            android:typeface="normal"
            tools:layout_editor_absoluteX="191dp"
            tools:layout_editor_absoluteY="6dp" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="167dp"
            android:layout_height="22dp"
            android:text="Borrower. Read. Grow"
            android:textSize="16sp"
            tools:layout_editor_absoluteX="191dp"
            tools:layout_editor_absoluteY="239dp" />

        <Button
            android:id="@+id/login"
            android:layout_width="400dp"
            android:layout_height="38dp"
            android:background="#F4EDED"
            android:backgroundTint="#E4DBDB"
            android:textColor="#000000"
            android:textStyle="bold"
            app:iconTint="#FBFBFB"
            tools:layout_editor_absoluteX="74dp"
            tools:layout_editor_absoluteY="298dp"
            tools:text="1. Log-in page" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="431dp"
            android:layout_height="209dp"
            android:src="@drawable/_847661961149339373"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.52"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.048"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="48dp"
            android:layout_height="55dp"
            android:src="@drawable/_966162926351343662_removebg_preview"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="290dp" />

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="48dp"
            android:layout_height="55dp"
            android:src="@drawable/autumn_book_cozy_cartoon_drawing_illustration_fall__removebg_preview"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="378dp" />

        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="49dp"
            android:layout_height="59dp"
            android:src="@drawable/form_flat_icon_removebg_preview"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="464dp" />

        <ImageView
            android:id="@+id/imageView7"
            android:layout_width="50dp"
            android:layout_height="63dp"
            android:src="@drawable/_688628599281820234_removebg_preview"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="550dp" />

        <Button
            android:id="@+id/borrow"
            android:layout_width="399dp"
            android:layout_height="39dp"
            android:text="2. Borrowing Page"
            android:textColor="#050505"
            android:textStyle="bold"
            tools:layout_editor_absoluteX="75dp"
            tools:layout_editor_absoluteY="378dp" />

        <Button
            android:id="@+id/borrowform"
            android:layout_width="399dp"
            android:layout_height="39dp"
            android:text="3. Borrowing Form Status"
            android:textColor="#000000"
            android:textStyle="bold"
            tools:layout_editor_absoluteX="75dp"
            tools:layout_editor_absoluteY="473dp" />

        <Button
            android:id="@+id/exit"
            android:layout_width="399dp"
            android:layout_height="39dp"
            android:text="4. Exit"
            android:textColor="#020202"
            android:textStyle="bold"
            tools:layout_editor_absoluteX="75dp"
            tools:layout_editor_absoluteY="558dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
