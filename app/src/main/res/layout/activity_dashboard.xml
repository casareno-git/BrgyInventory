<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BrgyInventory"
            android:textColor="#5426A8"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BORROW • READ • GROW"
            android:textColor="#88839A"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:gravity="center"
            android:layout_marginTop="5dp"/>

        <!-- LOGO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚"
            android:textSize="75sp"
            android:gravity="center"
            android:layout_marginTop="35dp"/>

        <!-- WELCOME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#29223D"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What would you like to do today?"
            android:textSize="14sp"
            android:textColor="#898497"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"/>

        <!-- PROFILE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="👤"
                android:textSize="25sp"
                android:gravity="center"
                android:background="#EEE6FF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#29223D"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View your personal information"
                    android:textSize="12sp"
                    android:textColor="#898497"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="85dp"
                android:layout_height="45dp"
                android:text="OPEN"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6429D9"/>
        </LinearLayout>

        <!-- BORROWING PAGE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="📖"
                android:textSize="25sp"
                android:gravity="center"
                android:background="#EEE6FF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Borrowing Page"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#29223D"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Borrow available inventory items"
                    android:textSize="12sp"
                    android:textColor="#898497"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnBorrowing"
                android:layout_width="85dp"
                android:layout_height="45dp"
                android:text="OPEN"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6429D9"/>
        </LinearLayout>

        <!-- BORROWING STATUS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="3dp"
            android:layout_marginBottom="30dp">

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="📋"
                android:textSize="25sp"
                android:gravity="center"
                android:background="#EEE6FF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Borrowing Status"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#29223D"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check your borrowing requests"
                    android:textSize="12sp"
                    android:textColor="#898497"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnStatus"
                android:layout_width="85dp"
                android:layout_height="45dp"
                android:text="OPEN"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6429D9"/>
        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BrgyInventory Management System"
            android:textColor="#A39DB1"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginBottom="15dp"/>

    </LinearLayout>
</ScrollView>
